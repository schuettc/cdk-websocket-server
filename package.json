{
  "name": "cdk-websocket-server",
  "scripts": {
    "build": "npx cdk synth",
    "deploy": "npx cdk deploy",
    "destroy": "npx cdk destroy",
    "diff": "npx cdk diff",
    "eslint": "eslint --ext .ts,.tsx --fix --no-error-on-unmatched-pattern src test",
    "load-test": "ts-node load-test.ts",
    "test": "jest",
    "watch": "npx cdk watch"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^18",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^7",
    "@typescript-eslint/parser": "^7",
    "aws-cdk": "^2.86.0",
    "cdk-nag": "^2.27.189",
    "esbuild": "^0.24.0",
    "eslint": "^8",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.31.0",
    "jest": "^29.7.0",
    "jest-junit": "^15",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.86.0",
    "constructs": "^10.0.5",
    "ws": "^8.19.0"
  },
  "engines": {
    "node": ">= 18.0.0"
  },
  "license": "MIT-0",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.0.0",
  "jest": {
    "coverageProvider": "v8",
    "testMatch": [
      "<rootDir>/@(src|test)/**/*(*.)@(spec|test).ts?(x)",
      "<rootDir>/@(src|test)/**/__tests__/**/*.ts?(x)"
    ],
    "clearMocks": true,
    "collectCoverage": true,
    "coverageReporters": [
      "json",
      "lcov",
      "clover",
      "cobertura",
      "text"
    ],
    "coverageDirectory": "coverage",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "watchPathIgnorePatterns": [
      "/node_modules/"
    ],
    "reporters": [
      "default"
    ],
    "transform": {
      "^.+\\.[t]sx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.dev.json"
        }
      ]
    }
  }
}
